# Quantum Code Technologies Environment Configuration Example
# Copy this file to .env.local for local development. Never commit real secrets.

# Optional: GitHub Personal Access Token (Server-side only) for higher rate limits on /api/github
GITHUB_TOKEN=

# Optional: Admin Governance Token for /admin and /api/admin mutations
ADMIN_ACCESS_TOKEN=

# Optional: SMTP Configuration for /api/contact email dispatch
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=quantumcode7777@gmail.com
